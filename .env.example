# 种子搜索 —— Docker Compose 配置
#
# 用法：cp .env.example .env，然后按需修改（不填的项会用默认值）。
# docker compose 会自动读取同目录下的 .env。

# 对外端口（宿主机）
TORRENT_SEARCH_PORT=8787

# 把端口发布到哪个地址。默认 127.0.0.1 = 只有服务器本机能访问。
# 本服务**默认没有鉴权**，任何能访问到它的人都能创建下载任务（往下载目录写文件），
# 所以服务器上推荐保持默认，用 SSH 隧道访问：
#     ssh -N -L 8787:127.0.0.1:8787 user@你的服务器
# 然后本地浏览器打开 http://127.0.0.1:8787/
# 想让局域网内其它设备直接访问，改成 0.0.0.0，并**先设置下面的 TORRENT_SEARCH_TOKEN**。
TORRENT_SEARCH_BIND=127.0.0.1

# 访问令牌。留空 = 不鉴权（保持旧行为）；**公网暴露时必须设置**一个足够长的随机串。
# 设置后，除 /api/health（容器健康检查用）以外的所有请求都要带 token，否则返回 401。
# 浏览器访问一次 http://服务器IP:8787/?token=你的token 即可，服务端会下发 30 天有效的
# HttpOnly Cookie，之后同源请求（含前端页面）自动携带，前端不用改。
# 脚本/curl 也可以带 Authorization: Bearer <token>。
# 生成随机串：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TORRENT_SEARCH_TOKEN=

# 宿主机上存放下载文件的目录。
# NAS 上可以改成 /volume1/downloads 之类的绝对路径。
TORRENT_SEARCH_DOWNLOADS=./downloads

# 构建镜像时使用的 UID/GID：绑定挂载会盖掉镜像里的属主，不一致就写不进下载目录。
# 构建时用环境变量传入即可（不必写进 .env）：
#     APP_UID=$(id -u) APP_GID=$(id -g) docker compose up -d --build
# 留空则用镜像默认的 10001，此时需要 sudo chown -R 10001:10001 ./downloads
APP_UID=10001
APP_GID=10001

# 打进镜像 OCI 标签的版本与提交，用于之后 docker inspect 核对"这是哪份代码"。
# 不传就是 unknown（OCI 标签不会变成真实版本号）。构建时传：
#     APP_VERSION=$(node -p "require('./package.json').version") \
#     GIT_REVISION=$(git rev-parse --short HEAD) docker compose up -d --build
APP_VERSION=unknown
GIT_REVISION=unknown

# 下载后端：auto（有 qBittorrent 就用它）/ builtin / qbittorrent
TORRENT_SEARCH_BACKEND=auto

# 宿主机上的 qBittorrent WebUI。
# 注意：容器里的 127.0.0.1 指向容器自己，必须用 host.docker.internal 才能连到宿主机。
TORRENT_SEARCH_QBITTORRENT=http://host.docker.internal:8080

# 可选：让 HTTP(S) 请求（搜索源）走宿主机的代理。
# BT 的 P2P 流量是 TCP/UDP，代理帮不上；要让 BT 走独立出口请用 VPN 容器（见 docker-compose.yml 末尾）。
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# 容器内部互访与回环不走代理（改了代理后建议保留这一行）
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
